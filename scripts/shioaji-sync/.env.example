# 永豐金證券 Shioaji API 帳號資訊
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# 交易數位憑證 (選填，若需要下單或完整未實現損益查詢)
SHIOAJI_PERSON_ID=A123456789
SHIOAJI_CERT_PATH=/path/to/Sinopac.pfx
SHIOAJI_CERT_PASS=your_cert_password

# Taiwan Fin Hub 目標 Worker 網址
TARGET_WORKER_URL=https://all-set-tw.ejijp6cl4.workers.dev

# 同步推送金鑰 (在 Taiwan Fin Hub 前台「設定 → 資料來源 → 永豐金證券」中自訂的 Sync Token)
SYNC_TOKEN=your_custom_sync_token

# Cloudflare Access Service Token (選填，若 Worker 設定為阻擋未授權流量)
# CF_ACCESS_CLIENT_ID=xxx.access
# CF_ACCESS_CLIENT_SECRET=xxx
